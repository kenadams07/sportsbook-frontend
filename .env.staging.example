POSTGRES_DB=sportsbook
POSTGRES_USER=sportsbook
POSTGRES_PASSWORD=replace-with-a-strong-password
# Use the same password as above, URL-encoded if it contains special characters.
DATABASE_URL=postgresql://sportsbook:replace-with-a-url-safe-password@postgres:5432/sportsbook

REDIS_PASSWORD=replace-with-a-strong-password
USER_JWT_SECRET=replace-with-a-long-random-secret

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_MAIL=

# Keep fake odds enabled until the full deployed flow is verified.
FAKE_ODDS_ENABLED=true
FAKE_ODDS_SPORTS=soccer_fifa_world_cup,cricket_odi,americanfootball_cfl

# Required only after FAKE_ODDS_ENABLED=false.
ODDS_API_KEY=
REDIS_HOST=redis

REDIS_PORT=6379

USER_SERVER_PORT=3020

ODDS_SERVER_PORT=3010

ADMIN_SERVER_PORT=3030

ODDS_API_BASE_URL=https://api.the-odds-api.com

EMAIL_DEV_OTP_RESPONSE=true
